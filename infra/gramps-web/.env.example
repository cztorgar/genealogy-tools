GRAMPSWEB_VERSION=26.10.1
GRAMPSWEB_PORT=5055
# absolutní cesta k media/ stromu (fotky a dokumenty — mimo git)
GRAMPS_MEDIA_DIR=/cesta/k/genealogy-trees/<strom>/media

# účty v Gramps Web (zakládá se: docker compose exec grampsweb python3 -m gramps_webapi user add …, viz docs/prirucka.md)
# master strom (jen doložené osoby) — nástroje tools/gramps/ zapisují pod tímto účtem
GRAMPSWEB_ADMIN_USER=
GRAMPSWEB_ADMIN_PASSWORD=
# referenční strom z importu GEDCOM / MyHeritage (jen nápovědy, volitelné)
GRAMPSWEB_REF_USER=
GRAMPSWEB_REF_PASSWORD=
